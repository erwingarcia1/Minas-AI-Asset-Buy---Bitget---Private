# Base ignore for the LEGACY bot image (root Dockerfile), which COPYs
# webapp/, chains/, memebuy/, payout/ and safety/ — do not exclude those here.
# The platform API build uses its own Dockerfile.api.dockerignore (BuildKit
# picks <Dockerfile-name>.dockerignore over this file), which excludes far
# more aggressively.
.git/
.gitignore
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
venv/
env/
.venv/
.env
.env.local
*.db
*.sqlite
*.sqlite3
config.json
*.local.json
*.pem
secrets/
data/
tests/
docs/
deploy/
frontend/
mobile/
*.md
