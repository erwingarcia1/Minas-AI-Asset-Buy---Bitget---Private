# systemd unit for running the bot directly on an ECS instance (no Docker).
# Install:
#   sudo cp deploy/autobuy.service /etc/systemd/system/autobuy.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now autobuy
# Logs:
#   journalctl -u autobuy -f

[Unit]
Description=Bitget sub-account USDT auto-buy bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autobuy
WorkingDirectory=/opt/autobuy
ExecStart=/opt/autobuy/.venv/bin/python /opt/autobuy/autobuy.py --config /opt/autobuy/config.json
# Optional: keep API secrets in a root-owned env file referenced as ${VAR}
# in config.json (chmod 600 /opt/autobuy/autobuy.env).
EnvironmentFile=-/opt/autobuy/autobuy.env
Restart=always
RestartSec=10
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/autobuy

[Install]
WantedBy=multi-user.target
