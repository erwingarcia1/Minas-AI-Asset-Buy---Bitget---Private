# Database
DATABASE_URL=postgresql+asyncpg://autobuy:autobuy_password@localhost:5432/autobuy_db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
# Separate key material for at-rest encryption of exchange API keys.
# REQUIRED in production; rotate with scripts/rotate_encryption_key.py
ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379/0

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
SUPPORT_EMAIL=support@minastech.ca

# Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Sumsub (KYC)
SUMSUB_APP_TOKEN=your_sumsub_app_token_here
SUMSUB_SECRET_KEY=your_sumsub_secret_key_here
SUMSUB_WEBHOOK_SECRET=your_sumsub_webhook_secret_here
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_API_URL=https://api.sumsub.com

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Scheduler
SCHEDULER_ENABLED=1
SCHEDULER_POLL_SECONDS=60
# Orders are SIMULATED unless this is set to 0 (real money!)
AUTOBUY_DRY_RUN=1

# Rate limiting
RATE_LIMIT_ENABLED=1
MAX_BODY_BYTES=1048576

# SMS (Twilio) + push (FCM) — leave unset to disable the channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=
