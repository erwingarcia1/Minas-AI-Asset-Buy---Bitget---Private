# Database
# In production set POSTGRES_PASSWORD (compose passes it to Postgres and the
# API) and mirror it here for host-side tools; the compose datastore ports
# are loopback-only either way.
POSTGRES_PASSWORD=autobuy_password
DATABASE_URL=postgresql+asyncpg://autobuy:autobuy_password@localhost:5432/autobuy_db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
# Leave empty locally. Production hosts set REQUIRE_PRODUCTION=1 (see .env.production.example).
REQUIRE_PRODUCTION=
SECRET_KEY=your-secret-key-change-this-in-production
# Separate key material for at-rest encryption of exchange API keys.
# REQUIRED in production; rotate with scripts/rotate_encryption_key.py
ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379/0

# Email (Resend) — every email the platform sends goes through api/integrations/resend.py.
# API key from https://resend.com/api-keys. Empty or a placeholder = email disabled (sends are logged and skipped).
RESEND_API_KEY=your_resend_api_key_here
# Sender for every email. Must be on a domain verified in Resend (Resend -> Domains).
# Never onboarding@resend.dev in production: it only delivers to the Resend account owner.
RESEND_FROM_EMAIL="Minas AutoBuy <noreply@your-verified-domain.com>"
# Reply-To on every email; leave empty to fall back to SUPPORT_EMAIL.
RESEND_REPLY_TO=
# Support inbox shown in email footers and used as the Reply-To fallback. Never a sender.
SUPPORT_EMAIL=support@your-company.com
# Public origin of the web app: the only base for links in emails (must be https in production).
APP_BASE_URL=http://localhost:5173
# Product name shown in email subjects and bodies.
APP_NAME=Minas AutoBuy
# Write password reset links to the API log for local testing (1 = on). Must stay 0/unset in production.
LOG_RESET_LINKS=0

# Binance

# Sumsub (KYC)
SUMSUB_APP_TOKEN=your_sumsub_app_token_here
SUMSUB_SECRET_KEY=your_sumsub_secret_key_here
SUMSUB_WEBHOOK_SECRET=your_sumsub_webhook_secret_here
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_API_URL=https://api.sumsub.com

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Scheduler
SCHEDULER_ENABLED=1
# Orders are SIMULATED unless this is set to 0 (real money!)
AUTOBUY_DRY_RUN=1
# Exchanges users may add keys for (comma-separated). Only Bitget is fully supported.
SUPPORTED_EXCHANGES=bitget
# How Bitget charges the withdrawal fee: exclusive (default; fee on top of the sent amount,
# so we send net - fee) or inclusive (Bitget deducts the fee from the sent amount).
BITGET_WITHDRAW_FEE_MODE=exclusive

# Rate limiting
RATE_LIMIT_ENABLED=1
MAX_BODY_BYTES=1048576

# SMS (Twilio) + push (FCM) — leave unset to disable the channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=

# Slack ops alerts
SLACK_WEBHOOK_URL=
# The server's public egress IP, shown to customers to allowlist on their Bitget API key
# (landing page setup guide and Settings). Served by GET /api/public/meta.
PUBLIC_SERVER_IP=
# Private beta: registration requires this invite code. Empty = open in development;
# in production an empty value closes registration. Rotate it if it leaks.
SIGNUP_INVITE_CODE=
# Telegram ops alerts (purchase completed/failed/parked, withdrawal sent/confirmed/failed).
# Bot token from @BotFather and the chat id of the group or DM the bot posts to.
# Both empty = disabled, the app runs exactly as without them. Never logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# At most this many Telegram messages per minute (identical failures collapse into one with a count)
TELEGRAM_MAX_PER_MINUTE=20
# Admin alert + Slack notice when more than this many emails could not be delivered in an hour
EMAIL_FAILURE_ALERT_THRESHOLD=5
# A fill outside this percentage of the expected amount / requested cost is parked as needs_review
FILL_TOLERANCE_PCT=10
# A fill deviating more than this (but within the tolerance) is still recorded, logged and counted for the fill_deviations alert
FILL_WARN_PCT=3
# Set to "null" to disable SQLAlchemy connection pooling (scheduler/one-off processes)
AUTOBUY_DB_POOL=
