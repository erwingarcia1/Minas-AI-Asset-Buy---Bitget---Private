{
  "name": "@autobuy/ts-client",
  "version": "0.4.1",
  "description": "Type-safe TypeScript client for the AutoBuy Crypto API (generated from OpenAPI)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"build-test/test/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "autobuy",
    "crypto",
    "api-client",
    "openapi",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.4.0"
  }
}
