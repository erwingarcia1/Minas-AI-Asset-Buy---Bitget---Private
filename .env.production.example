# =============================================================================
# AutoBuy platform — PRODUCTION environment template
#
#   cp .env.production.example .env        # on the server, as root, chmod 600
#   python scripts/validate_env.py .env    # refuses placeholders / weak keys
#   bash scripts/deploy.sh platform
#
# Every value below is a placeholder. The API's boot guard refuses to start in
# production on default or short secrets, and scripts/deploy.sh refuses to
# start the stack without SECRET_KEY / ENCRYPTION_KEY. Never commit the
# filled-in file: .env and every .env.* variant are gitignored.
# =============================================================================

# --- Runtime mode ------------------------------------------------------------
# "production" enables the secret guard, HSTS, and Alembic-only schema management.
API_ENV=production
# Production hosts set this: the API refuses to start unless API_ENV is exactly "production".
REQUIRE_PRODUCTION=1
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Secrets (REQUIRED) ------------------------------------------------------
# JWT signing key. Must be 32+ characters; rotating it logs every user out.
#   generate:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# Fernet key material for exchange API keys stored at rest. Independent from
# SECRET_KEY. Rotate ONLY with scripts/rotate_encryption_key.py (app stopped);
# changing it by hand makes every stored exchange key undecryptable.
#   generate:  openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Datastores (REQUIRED) ---------------------------------------------------
# docker-compose.yml passes POSTGRES_PASSWORD to Postgres and builds the API's
# DATABASE_URL from it (host "postgres" on the compose network). Keep the two
# in sync; DATABASE_URL here is used by host-side tools (alembic, backups).
#   generate:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
DATABASE_URL=postgresql+asyncpg://autobuy:CHANGE_ME_strong_database_password@localhost:5432/autobuy_db
# Rate limits, login lockout, token revocation and the scheduler lock live here.
REDIS_URL=redis://localhost:6379/0

# --- Trading safety ----------------------------------------------------------
# Orders are SIMULATED while this is 1. Set to 0 only after the Binance
# testnet run and a small-amount canary (PRODUCTION_READINESS.md).
AUTOBUY_DRY_RUN=1
# Emergency stop: 0 halts all scheduled execution (read at startup).
SCHEDULER_ENABLED=1

# --- Web origins -------------------------------------------------------------
# CSV of browser origins allowed by CORS: the dashboard's public URL(s).
ALLOWED_ORIGINS=https://app.autobuy.app
# Origin used in emailed links (email verification). Defaults to the first
# ALLOWED_ORIGINS entry when unset.
APP_BASE_URL=https://app.autobuy.app

# --- Email: Resend (issue #28) ----------------------------------------------
# From https://resend.com/api-keys. Required: the API refuses to boot in production without it.
RESEND_API_KEY=re_CHANGE_ME
# Sender for every email; the domain MUST be verified in Resend (SPF/DKIM). Required.
# resend.dev / autobuy.platform senders are refused at boot.
RESEND_FROM_EMAIL="Minas AutoBuy <noreply@minastrade.com>"
# Reply-To on every email (defaults to SUPPORT_EMAIL when empty).
RESEND_REPLY_TO=support@minastech.ca
# Support inbox shown in email footers. Never a sender.
SUPPORT_EMAIL=support@minastech.ca
# Product name in subjects and bodies.
APP_NAME=Minas AutoBuy
# Must stay 0 in production (refused at boot when 1).
LOG_RESET_LINKS=0

# --- KYC: Sumsub (issue #27) -------------------------------------------------
# Production app token + secret from the Sumsub dashboard (App Tokens).
SUMSUB_APP_TOKEN=prd:CHANGE_ME
SUMSUB_SECRET_KEY=CHANGE_ME
# Secret configured on the webhook in Sumsub (Dev space -> Webhooks); the API
# verifies x-payload-digest with it. Point the webhook at
#   https://<api host>/api/webhooks/sumsub
SUMSUB_WEBHOOK_SECRET=CHANGE_ME
# Verification level name as defined in the Sumsub dashboard.
SUMSUB_LEVEL_NAME=id-only
SUMSUB_API_URL=https://api.sumsub.com

# --- Exchange ----------------------------------------------------------------
# Platform-level Binance credentials are NOT required: users store their own
# keys (encrypted with ENCRYPTION_KEY). Leave unset unless a service account
# is needed for price data.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- JWT lifetimes -----------------------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Hardening ---------------------------------------------------------------
RATE_LIMIT_ENABLED=1
MAX_BODY_BYTES=1048576

# --- Optional channels (unset = channel disabled) ----------------------------
# SMS via Twilio (issue #29)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Push via Firebase Cloud Messaging (issue #30)
FCM_SERVER_KEY=
# Ops alerts to Slack (incoming webhook URL)
SLACK_WEBHOOK_URL=
